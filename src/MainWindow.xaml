<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="RootWindow"
        Title="Focus Harbor · 专注中枢"
        Width="1080" Height="740" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF080C18"
        FontFamily="Microsoft YaHei UI" Foreground="#FFF4F7FF"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="16" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF4F7FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF98A4BE"/>
        <SolidColorBrush x:Key="Accent" Color="#FF7C6BFF"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#FF33D6C8"/>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D11A2238" Offset="0"/>
            <GradientStop Color="#B911192B" Offset="0.55"/>
            <GradientStop Color="#A70C1424" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBorder" Color="#2EFFFFFF"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="#3BFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#FF9DA8C0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#167C6BFF"/>
                                <Setter Property="Foreground" Value="#FFEAE7FF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="NavSurface" Property="Background" Value="#267C6BFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#FF7563F6"/>
            <Setter Property="BorderBrush" Value="#707C6BFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF8474FF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A8B4A8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF6251DE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE9EDF7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#8A151D31"/>
            <Setter Property="BorderBrush" Value="#4E71809D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B6222D46"/><Setter TargetName="Surface" Property="BorderBrush" Value="#8499BAE5"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D0141B2C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RewardActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFFF9FA7"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#FF9BA6BC"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1EFFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="RuleSettingsButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="#FFAFA7FF"/><Setter Property="Background" Value="#167C6BFF"/>
            <Setter Property="ToolTip" Value="设置允许时间"/>
        </Style>

        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="26"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" Background="#FF30394E" CornerRadius="13" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Margin="3" HorizontalAlignment="Left" Fill="#FFDCE3F2">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#FF7563F6"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/><Setter TargetName="Thumb" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="CaretBrush" Value="#FFFFFFFF"/><Setter Property="SelectionBrush" Value="#FF7563F6"/><Setter Property="SelectionOpacity" Value="0.65"/>
            <Setter Property="Background" Value="#FF0D1628"/><Setter Property="BorderBrush" Value="#5A66738E"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="InputShell" TargetType="Border">
            <Setter Property="Background" Value="#FF0D1628"/><Setter Property="BorderBrush" Value="#5A66738E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FF8878FF"/><Setter Property="Background" Value="#FF111C31"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFDCE3F2"/><Setter Property="Padding" Value="11,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#287C6BFF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#367C6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFEDF2FC"/><Setter Property="Background" Value="#FF11192A"/><Setter Property="BorderBrush" Value="#3AFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0"/><Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface" Height="40" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="#FF8490A8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,6,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Padding="5" Background="#FF11192A" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="11"><Border.Effect><DropShadowEffect Color="#C0000000" BlurRadius="22" ShadowDepth="5" Opacity="0.55"/></Border.Effect><ScrollViewer><ItemsPresenter/></ScrollViewer></Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#B07C6BFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#FF172137"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFDCE3F2"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#18FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#317C6BFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ScrollRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Width="5" Margin="1" Background="#52616E89" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#9A7C6BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowSurface">
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.05" GradientOrigin="0.18,0.05" RadiusX="1.1" RadiusY="1.1">
                <GradientStop Color="#FF1C1740" Offset="0"/><GradientStop Color="#FF0A1020" Offset="0.55"/><GradientStop Color="#FF070B15" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="430" Height="430" Canvas.Left="630" Canvas.Top="-260" Opacity="0.19">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF7967FF"/><GradientStop Color="#007967FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                <Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-55" Duration="0:0:8"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="38" Duration="0:0:10"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="360" Height="360" Canvas.Left="130" Canvas.Top="520" Opacity="0.13">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF27D6C5"/><GradientStop Color="#0027D6C5" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                <Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="70" Duration="0:0:12"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-35" Duration="0:0:9"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B90A0F1C" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0">
                <Grid Margin="18,18,14,18">
                    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="38" Height="38" CornerRadius="12">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF8B78FF"/><GradientStop Color="#FF35D7C8" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid><Ellipse Width="18" Height="18" Stroke="White" StrokeThickness="2"/><Ellipse Width="5" Height="5" Fill="White"/></Grid>
                        </Border>
                        <StackPanel Margin="11,1,0,0"><TextBlock Text="FOCUS HARBOR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" Foreground="White"/><TextBlock Text="专注中枢" Foreground="#FF8792AA" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,25,0,0">
                        <TextBlock Text="控制台" Foreground="#FF68748E" FontSize="11" FontWeight="Bold" Margin="12,0,0,8"/>
                        <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Tag="active"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" Width="27"/><TextBlock Text="总览"/></StackPanel></Button>
                        <Button x:Name="BrowserNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="16" Width="27"/><TextBlock Text="浏览器"/></StackPanel></Button>
                        <Button x:Name="AppsNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" FontSize="16" Width="27"/><TextBlock Text="应用守卫"/></StackPanel></Button>
                        <Button x:Name="AlarmNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7ED;" FontSize="16" Width="27"/><TextBlock Text="晨间闹钟"/></StackPanel></Button>
                        <Button x:Name="RewardsNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE735;" FontSize="16" Width="27"/><TextBlock Text="学习奖励"/></StackPanel></Button>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Width="27"/><TextBlock Text="设置"/></StackPanel></Button>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#12FFFFFF" CornerRadius="13" Padding="12">
                        <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#FF33D6C8" Margin="0,0,8,0"/><TextBlock x:Name="SidebarStatus" Text="守卫运行中" FontSize="12" Foreground="#FFB7C1D7"/></StackPanel><TextBlock x:Name="GpuTierText" Text="GPU 渲染检测中" FontSize="10" Foreground="#FF66728A" Margin="16,5,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                    <TextBlock x:Name="PageTitle" Text="总览" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="28,0,0,0" Foreground="#FFDCE3F2"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Background="#142D3951" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="12" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;"/>
                            <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;"/>
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="28,4,28,26">
                    <Grid x:Name="OverviewPage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border CornerRadius="22" Padding="28" BorderBrush="#38FFFFFF" BorderThickness="1">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D52A225B"/><GradientStop Color="#C3143345" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" Background="#1EFFFFFF" CornerRadius="20" Padding="11,5" Margin="0,0,0,14"><TextBlock x:Name="HeroBadge" Text="●  等待开启" Foreground="#FFC1CADC" FontSize="11" FontWeight="Bold"/></Border>
                                    <TextBlock Text="把选择留给清醒的自己。" FontSize="29" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="HeroSubtitle" Text="浏览器白名单与应用守卫正在协同工作。" TextWrapping="Wrap" FontSize="13" Foreground="#FFB5C0D6" Margin="0,10,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PauseNowButton" Style="{StaticResource PrimaryButton}" Content="暂时解除 30 分钟" Width="188"/>
                                        <StackPanel Margin="18,1,0,0"><TextBlock x:Name="DailyAllowanceText" Text="今日剩余 3 次" Foreground="#FF8F9BB4" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="UsageDot1" Width="8" Height="8" Fill="#FF7C6BFF" Margin="0,0,6,0"/><Ellipse x:Name="UsageDot2" Width="8" Height="8" Fill="#FF2D3549" Margin="0,0,6,0"/><Ellipse x:Name="UsageDot3" Width="8" Height="8" Fill="#FF2D3549" Margin="0,0,6,0"/><Ellipse x:Name="UsageDot4" Width="8" Height="8" Fill="#FF2D3549"/></StackPanel></StackPanel>
                                    </StackPanel>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="ResumeFocusButton" Style="{StaticResource SecondaryButton}" Content="立即恢复专注" Width="142" Height="36" Visibility="Collapsed" Margin="0,0,10,0" ToolTip="提前结束当前解除；已用普通额度与学习奖励不返还"/>
                                        <Button x:Name="ForfeitAllowanceButton" Style="{StaticResource DangerButton}" Content="放弃今日剩余额度" Width="164" Height="36" ToolTip="需二次确认；当天不可撤销，学习奖励不受影响"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="160" Height="160" HorizontalAlignment="Right">
                                    <Ellipse Stroke="#18FFFFFF" StrokeThickness="10"/>
                                    <Ellipse x:Name="PauseRing" Stroke="#FF53D9CB" StrokeThickness="10" StrokeDashArray="1.8,0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="CountdownText" Text="待开启" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="CountdownCaption" Text="配置保持" Foreground="#FF96A2B9" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Height="260" Padding="18">

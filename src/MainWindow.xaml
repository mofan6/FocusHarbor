                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Height="260" Padding="18">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D3201D40"/><GradientStop Color="#C311192C" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="12" Background="#287C6BFF"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Foreground="#FFB4ABFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0,0,0"><TextBlock Text="应用与文件守卫" Foreground="#FF8F9BB4" FontSize="11"/><TextBlock x:Name="GuardStatusLarge" Text="尚未开启" FontSize="17" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><Ellipse Grid.Column="2" Width="7" Height="7" Fill="#FF8B78FF" VerticalAlignment="Top" Margin="0,5,1,0"/></Grid>
                                    <Border Grid.Row="2" Background="#8B0E1728" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10"><TextBlock x:Name="AppPreviewText" Text="暂无启用规则" TextWrapping="Wrap" Foreground="#FFD0D8E7" FontSize="11" LineHeight="18"/></Border>
                                    <Grid Grid.Row="4" MinHeight="52"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#157C6BFF" CornerRadius="9" Padding="9,7"><StackPanel><TextBlock Text="规则粒度" Foreground="#FF8492AA" FontSize="10" LineHeight="16"/><TextBlock Text="独立时段" Foreground="#FFC0B9FF" FontSize="11" FontWeight="Bold" LineHeight="18" Margin="0,1,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#1528BFB3" CornerRadius="9" Padding="9,7" Margin="7,0,0,0"><StackPanel><TextBlock Text="后台状态" Foreground="#FF8492AA" FontSize="10" LineHeight="16"/><TextBlock Text="实时守护" Foreground="#FF9DDBD5" FontSize="11" FontWeight="Bold" LineHeight="18" Margin="0,1,0,0"/></StackPanel></Border></Grid>
                                    <TextBlock x:Name="AppStatusDetail" Grid.Row="5" Text="5 条预置规则可配置" Foreground="#FF75829A" FontSize="10" Margin="0,9,0,0"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Height="260" Padding="18">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CF123D45"/><GradientStop Color="#CA111A2B" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="12" Background="#2833D6C8"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;" Foreground="#FF6CE1D6" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0,0,0"><TextBlock Text="累计专注" Foreground="#FF9FC4C9" FontSize="11"/><TextBlock x:Name="FocusTotalText" Text="0 分钟" FontSize="21" FontWeight="Bold" Foreground="#FF75E1D6" Margin="0,2,0,0"/></StackPanel></Grid>
                                    <Border Grid.Row="2" Background="#5C21AFA3" BorderBrush="#3033D6C8" BorderThickness="1" CornerRadius="12" Padding="12,10"><StackPanel><TextBlock Text="本次记录状态" Foreground="#FF78BFB8" FontSize="9"/><TextBlock x:Name="FocusAccountingText" Text="开启任一防护后开始累计" TextWrapping="Wrap" Foreground="#FFC0DBD8" FontSize="11" LineHeight="18" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Grid Grid.Row="4" MinHeight="52"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#1628BFB3" CornerRadius="9" Padding="9,7"><StackPanel><TextBlock Text="关闭窗口" Foreground="#FF8492AA" FontSize="10" LineHeight="16"/><TextBlock Text="持续记录" Foreground="#FF9DDBD5" FontSize="11" FontWeight="Bold" LineHeight="18" Margin="0,1,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#157C6BFF" CornerRadius="9" Padding="9,7" Margin="7,0,0,0"><StackPanel><TextBlock Text="再次启动" Foreground="#FF8492AA" FontSize="10" LineHeight="16"/><TextBlock Text="自动补算" Foreground="#FFC0B9FF" FontSize="11" FontWeight="Bold" LineHeight="18" Margin="0,1,0,0"/></StackPanel></Border></Grid>
                                    <TextBlock Grid.Row="5" Text="数据保存在本机 · 自动保存" Foreground="#FF75829A" FontSize="10" Margin="0,9,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="BrowserPage" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="浏览器白名单" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="BrowserCoverageText" Text="自动覆盖电脑中发现的浏览器；本地 HTML、PDF 通过 file:// 规则打开。" Foreground="#FF8995AD" FontSize="12" Margin="0,7,0,0"/></StackPanel><CheckBox x:Name="BrowserEnabledToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/></Grid>
                        </Border>
                        <Border x:Name="BrowserLockBanner" Grid.Row="2" Background="#20FFB86C" BorderBrush="#55FFB86C" BorderThickness="1" CornerRadius="11" Padding="13,9"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="#FFFFC77C" Margin="0,0,9,0"/><TextBlock Text="专注状态已锁定：临时解除后才能修改浏览器规则。" Foreground="#FFFFD7A0" FontSize="11"/></StackPanel></Border>
                        <Grid x:Name="BrowserSettingsPanel" Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><TextBlock Text="已放行规则" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="AllowlistCountText" Text="22" HorizontalAlignment="Right" Foreground="#FF7E8AA2"/></Grid>
                                    <ListBox x:Name="AllowlistBox" Grid.Row="2" Background="#86101625" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="5"/>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal"><Button x:Name="RemoveDomainButton" Style="{StaticResource DangerButton}" Content="移除所选" Width="108"/><Button x:Name="ApplyBrowserButton" Style="{StaticResource PrimaryButton}" Content="应用更改" Width="118" Margin="10,0,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel><TextBlock Text="添加网站" FontSize="14" FontWeight="Bold"/><TextBlock Text="输入域名、URL 或受支持的策略模式。域名规则会覆盖该站全部路径。" TextWrapping="Wrap" Foreground="#FF7F8BA3" FontSize="11" Margin="0,8,0,18"/><TextBlock Text="规则" Foreground="#FF9AA5BA" FontSize="11" Margin="2,0,0,7"/><Border Style="{StaticResource InputShell}" Height="42"><TextBox x:Name="DomainInput" Background="Transparent" BorderThickness="0" Padding="13,0" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"/></Border><Button x:Name="AddDomainButton" Style="{StaticResource SecondaryButton}" Content="加入白名单" Margin="0,12,0,0"/><Border Background="#142AD8C8" BorderBrush="#3033D6C8" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,22,0,0"><StackPanel><TextBlock Text="提示" Foreground="#FF69E0D4" FontWeight="Bold" FontSize="11"/><TextBlock Text="浏览器通常会在数秒内刷新企业策略；若页面仍显示旧状态，请完全重启浏览器。" TextWrapping="Wrap" Foreground="#FF8FA7B5" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AppsPage" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="应用与文件守卫" FontSize="21" FontWeight="Bold"/><TextBlock Text="传统软件按路径、商店应用按应用包身份守卫；普通文件独占锁定。" Foreground="#FF8995AD" FontSize="12" Margin="0,7,0,0"/></StackPanel><CheckBox x:Name="AppGuardEnabledToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/></Grid></Border>
                        <Border x:Name="AppsLockBanner" Grid.Row="2" Background="#20FFB86C" BorderBrush="#55FFB86C" BorderThickness="1" CornerRadius="11" Padding="13,9"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="#FFFFC77C" Margin="0,0,9,0"/><TextBlock Text="专注状态已锁定：临时解除后才能增删或修改守卫规则。" Foreground="#FFFFD7A0" FontSize="11"/></StackPanel></Border>
                        <Grid x:Name="AppsEditorPanel" Grid.Row="4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>

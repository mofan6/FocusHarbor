                                <Grid>
                                    <Grid x:Name="AppAddControls"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="126"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="InstalledSoftwarePicker" Style="{StaticResource ModernComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="#267C6BFF"><Grid><TextBlock Text="{Binding Initial}" Foreground="#FFD8D2FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                                                        <Grid Grid.Column="1" Margin="9,0,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" Foreground="#FFF1F4FB" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding LocationText}" Foreground="#FF738099" FontSize="9" TextTrimming="CharacterEllipsis"/></Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button x:Name="RefreshInstalledAppsButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Height="40" Margin="8,0,0,0" Padding="0" ToolTip="重新扫描传统软件与 Microsoft Store 应用"/>
                                        <Button x:Name="AddInstalledAppButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="添加已装软件" Height="40" Margin="10,0,0,0" Padding="10,0"/>
                                        <Button x:Name="AddFileButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="添加文件" Height="40" Margin="10,0,0,0" Padding="10,0"/>
                                    </Grid>
                                    <Border x:Name="AppAddLockedSurface" Height="40" Background="#BF111A2B" BorderBrush="#3533D6C8" BorderThickness="1" CornerRadius="11"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="#FF6FE1D5" Margin="0,0,9,0"/><TextBlock Text="配置入口已封存 · 临时解除后可添加软件或文件" Foreground="#FF9FC2C9" FontSize="11"/></StackPanel></Border>
                                </Grid>
                            </Border>
                            <ListBox x:Name="AppRulesBox" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#A912192B" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="10" Background="#257C6BFF"><Grid><TextBlock Text="{Binding Badge}" Foreground="#FFD8D2FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding IconSource}" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,14,0"><TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13"/><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="#FF7D89A1" FontSize="10.5" Margin="0,5,0,0"/></StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource RuleSettingsButton}" Tag="rule-settings" Content="&#xE713;" DataContext="{Binding}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Style="{StaticResource RuleSettingsButton}" Tag="rule-delete" Content="&#xE74D;" Foreground="#FFFFB3A9" DataContext="{Binding}" VerticalAlignment="Center" ToolTip="删除此规则；不删除软件或文件，需处于解除限制状态"/>
                                                <CheckBox Grid.Column="4" Style="{StaticResource ToggleStyle}" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RemoveAppRuleButton" Style="{StaticResource DangerButton}" Content="移除选中规则" Width="142"/><Button x:Name="ApplyAppsButton" Style="{StaticResource PrimaryButton}" Content="保存守卫规则" Width="145" Margin="10,0,0,0"/></StackPanel>
                    </Grid>

                    <Grid x:Name="AlarmPage" Visibility="Collapsed" Opacity="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="晨间闹钟与打字任务" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="AlarmScheduleStatusText" Text="未启用 · 配置保存后由 Windows 唤醒计时器触发" Foreground="#FF8995AD" FontSize="12" Margin="0,7,0,0"/></StackPanel>
                                        <CheckBox x:Name="AlarmEnabledToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="AlarmLockBanner" Background="#20FFB86C" BorderBrush="#55FFB86C" BorderThickness="1" CornerRadius="11" Padding="13,9" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="#FFFFC77C" Margin="0,0,9,0"/><TextBlock x:Name="AlarmLockBannerText" Text="晨间闹钟配置仅可在每天 00:00–02:00 修改。" Foreground="#FFFFD7A0" FontSize="11"/></StackPanel></Border>
                                <Grid x:Name="AlarmSettingsPanel" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="唤醒设置" FontSize="15" FontWeight="Bold"/>
                                                <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="每天响铃时间" Foreground="#FF8E9AB2" FontSize="11" Margin="2,0,0,7"/><Border Style="{StaticResource InputShell}" Height="42"><TextBox x:Name="AlarmTimeInput" Text="07:00" Background="Transparent" BorderThickness="0" Padding="13,0" VerticalContentAlignment="Center" MaxLength="5"/></Border></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="闹铃音乐" Foreground="#FF8E9AB2" FontSize="11" Margin="2,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><Border Style="{StaticResource InputShell}" Height="42"><TextBox x:Name="AlarmMusicPathText" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="13,0" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"/></Border><Button x:Name="ChooseAlarmMusicButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择音乐" Height="42" Margin="9,0,0,0" Padding="8,0"/></Grid></StackPanel>
                                                </Grid>
                                                <TextBlock Text="专用押金文件夹（必须是 E 盘的安全子文件夹）" Foreground="#FF8E9AB2" FontSize="11" Margin="2,16,0,7"/>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Border Style="{StaticResource InputShell}" Height="42"><TextBox x:Name="AlarmDepositFolderText" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="13,0" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"/></Border><Button x:Name="ChooseDepositFolderButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择文件夹" Height="42" Margin="9,0,0,0" Padding="8,0"/></Grid>
                                                <Border Background="#1328BFB3" BorderBrush="#3033D6C8" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,16,0,0"><TextBlock Text="超时后三项同时执行：可恢复地隔离整个专用押金文件夹（120 小时后自动恢复）；立即恢复专注限制并在当天禁用临时解除；当天禁止启动 Codex。桌面、文档、云盘、系统与软件目录以及链接目录均会被拒绝。" TextWrapping="Wrap" Foreground="#FFA7D7D3" FontSize="11" LineHeight="18"/></Border>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,14,0,0">
                                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid><TextBlock Text="必须手打的内容" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="AlarmCharacterCountText" Text="0 / 150 字符" HorizontalAlignment="Right" Foreground="#FF8E9AB2" FontSize="11"/></Grid>
                                                <Border Grid.Row="2" Style="{StaticResource InputShell}"><TextBox x:Name="AlarmChallengeText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="13,10" VerticalContentAlignment="Top"/></Border>
                                                <TextBlock Grid.Row="3" Text="保存启用后，响铃起 15 分钟内必须逐字输入完全一致的内容；粘贴、剪切、复制、拖放均被禁用。" Foreground="#FF7F8BA3" TextWrapping="Wrap" FontSize="10.5" Margin="2,10,0,0"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="SaveAlarmButton" Style="{StaticResource PrimaryButton}" Content="保存晨间闹钟" HorizontalAlignment="Right" Width="166" Margin="0,14,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="押金隔离记录" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Grid.Row="2" Text="只有闹钟任务超时才会产生记录。整个押金文件夹在满 120 小时后自动恢复；若原位置重名，则安全保留记录等待手动恢复。" Foreground="#FF7F8BA3" TextWrapping="Wrap" FontSize="10.5" LineHeight="17"/>
                                            <ListBox x:Name="QuarantineList" Grid.Row="4" MinHeight="360" Background="#6A0D1525" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="5" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusText}" Foreground="#FF7D89A1" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="RefreshQuarantineButton" Style="{StaticResource SecondaryButton}" Content="刷新" Height="40"/><Button x:Name="RestoreQuarantineButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="恢复所选" Height="40" Margin="8,0,0,0"/></Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Text="提示：从完全关机状态通常无法自动开机；此功能面向睡眠/休眠，且主板与 Windows 必须允许唤醒计时器。" Foreground="#FF66728A" FontSize="10" Margin="4,14,0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="RewardsPage" Visibility="Collapsed" Opacity="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border CornerRadius="22" Padding="26" BorderBrush="#52FFFFFF" BorderThickness="1">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E12B245B"/><GradientStop Color="#D0173C48" Offset="0.62"/><GradientStop Color="#C8101A2D" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" Background="#2533D6C8" BorderBrush="#3933D6C8" BorderThickness="1" CornerRadius="18" Padding="11,5"><TextBlock Text="SELF-HONESTY REWARD" Foreground="#FF8DE8DF" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold"/></Border>
                                            <TextBlock Text="认真完成，清醒奖励。" FontSize="27" FontWeight="Bold" Margin="0,13,0,0"/>
                                            <TextBlock Text="每科每天确认一次；亲手写完说明，获得一份独立的 10 分钟解除额度。" Foreground="#FFB1BDD3" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <Grid Width="210" Height="7" HorizontalAlignment="Left" Margin="0,19,0,0"><Border Background="#372C3854" CornerRadius="4"/><Rectangle x:Name="RewardProgressFill" Width="0" HorizontalAlignment="Left" RadiusX="4" RadiusY="4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF7C6BFF"/><GradientStop Color="#FF45D9CC" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid>
                                            <TextBlock x:Name="RewardProgressText" Text="今日已认真确认 0 / 4 科" Foreground="#FF8592AA" FontSize="10.5" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#5910182A" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="17" Padding="18" Margin="18,0,0,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="当前可用" Foreground="#FF8E9BB3" FontSize="10.5"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock x:Name="RewardAvailableText" Text="0 份" FontSize="29" FontWeight="Bold" Foreground="#FF70E1D6"/><TextBlock x:Name="RewardMinutesTotalText" Text="可用 0 分钟" Foreground="#FF92A2BD" FontSize="11" VerticalAlignment="Bottom" Margin="12,0,0,5"/></StackPanel>
                                                <Button x:Name="UseRewardButton" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,15,0,0" Padding="11,0"><StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="8" Background="#35FFFFFF" BorderBrush="#60FFFFFF" BorderThickness="1" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE785;" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="RewardUseButtonText" Text="先完成一科并手写说明" VerticalAlignment="Center"/></StackPanel></Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="#70101829" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="0,14,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="科目管理" FontSize="12.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="RewardSubjectManageHint" Text="仅在临时解除限制期间可以添加、删除或重命名" Foreground="#FF7F8CA5" FontSize="10.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="AddRewardSubjectButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="＋ 添加科目" Width="112" Height="38" Padding="10,0" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="RewardSubjects" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,12,12" Height="174">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Width="42" Height="42" CornerRadius="13" Background="#267C6BFF" BorderBrush="#30FFFFFF" BorderThickness="1"><TextBlock Text="{Binding Badge}" Foreground="{Binding Accent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                        <StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding Accent}" Margin="0,12,7,0" VerticalAlignment="Top"/>
                                                            <Button Tag="rename-reward-subject" DataContext="{Binding}" Style="{StaticResource IconButton}" Content="&#xE70F;" Width="31" Height="30" IsEnabled="{Binding ManageEnabled}" ToolTip="重命名科目"/>
                                                            <Button Tag="delete-reward-subject" DataContext="{Binding}" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="31" Height="30" Foreground="#FFFF929D" IsEnabled="{Binding ManageEnabled}" ToolTip="删除科目"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#FF8290A9" FontSize="10.5" Margin="1,12,0,0" TextWrapping="Wrap"/>
                                                    <Button Grid.Row="2" Tag="claim-reward" DataContext="{Binding}" Style="{StaticResource RewardActionButton}" Content="{Binding ActionText}" IsEnabled="{Binding ActionEnabled}" Height="42" FontSize="11.5"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#122AD8C8" BorderBrush="#3033D6C8" BorderThickness="1" CornerRadius="13" Padding="14,10" Margin="0,2,12,4"><TextBlock Text="奖励只增加专注限制的临时解除时间，不消耗每日 3 次普通额度；若晨间任务超时，当天所有解除方式仍会被锁定。" Foreground="#FF9ECBC7" FontSize="10.5" TextWrapping="Wrap"/></Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="设置与使用教程" FontSize="20" FontWeight="Bold"/><TextBlock Text="完整 Markdown 文档已编译进软件，可按功能、问题或关键词搜索。" Foreground="#FF8995AD" FontSize="11" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="#1D33D6C8" BorderBrush="#3033D6C8" BorderThickness="1" CornerRadius="14" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="USERGUIDE.MD" Foreground="#FF7DDFD6" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/></Border></Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="276"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource InputShell}" Height="40"><Grid><TextBox x:Name="TutorialSearchBox" Background="Transparent" BorderThickness="0" Padding="38,0,12,0" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"/><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#FF77839B" FontSize="13" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/><TextBlock x:Name="TutorialSearchHint" Text="在 UserGuide.md 中搜索…" Foreground="#FF657189" FontSize="11" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False"/></Grid></Border>
                                    <Border Grid.Row="2" Background="#6A0D1525" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16">
                                        <FlowDocumentScrollViewer x:Name="TutorialDocumentViewer" Background="Transparent" BorderThickness="0" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                    <TextBlock Text="当前规则" FontSize="14" FontWeight="Bold"/>
                                    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#70101829" CornerRadius="11" Padding="12"><StackPanel><TextBlock Text="临时解除" Foreground="#FF7D89A1" FontSize="10"/><TextBlock x:Name="PauseMinutesText" Text="30 分钟" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#70101829" CornerRadius="11" Padding="12" Margin="8,0,0,0"><StackPanel><TextBlock Text="每日上限" Foreground="#FF7D89A1" FontSize="10"/><TextBlock x:Name="DailyPauseLimitText" Text="3 次" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border></Grid>
                                    <Border Height="1" Background="#20FFFFFF" Margin="0,16"/>
                                    <TextBlock Text="维护" FontSize="14" FontWeight="Bold"/><TextBlock Text="按当前配置重建浏览器策略并确认后台守卫。" Foreground="#FF7E8AA2" TextWrapping="Wrap" FontSize="10.5" LineHeight="18" Margin="0,6,0,12"/>
                                    <Button x:Name="ReapplyButton" Style="{StaticResource SecondaryButton}" Content="重新应用全部规则" Height="40"/>
                                    <Border Height="1" Background="#20FFFFFF" Margin="0,16"/>
                                    <TextBlock Text="立即解除全部限制" Foreground="#FFFFA2A9" FontWeight="Bold"/><TextBlock Text="停止守卫并移除浏览器策略；不会删除规则。" Foreground="#FF7E8AA2" TextWrapping="Wrap" FontSize="10.5" LineHeight="18" Margin="0,6,0,12"/>
                                    <Button x:Name="RestoreAllButton" Style="{StaticResource DangerButton}" Content="恢复无限制状态" Height="40"/>
                                </StackPanel></ScrollViewer>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="Designed By MOTAN" HorizontalAlignment="Center" Foreground="#FF59647A" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"/>
                    </Grid>

                    <Border x:Name="ToastHost" Background="#F12B344A" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="12" Padding="15,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" Opacity="0"><TextBlock x:Name="ToastText" Text="已保存" Foreground="White" FontSize="12"/></Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

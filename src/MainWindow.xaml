                                    <Border Grid.Row="2" Background="#8B0E1728" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10"><TextBlock x:Name="BrowserPreviewText" Text="ChatGPT · Gemini · 本地文件" TextWrapping="Wrap" Foreground="#FFD0D8E7" FontSize="11" LineHeight="18"/></Border>
                                    <Grid Grid.Row="4" MinHeight="52"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#1528BFB3" CornerRadius="9" Padding="9,7"><StackPanel><TextBlock Text="策略状态" Foreground="#FF8492AA" FontSize="10" LineHeight="16"/><TextBlock Text="自动同步" Foreground="#FF9DDBD5" FontSize="11" FontWeight="Bold" LineHeight="18" Margin="0,1,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#151D88FF" CornerRadius="9" Padding="9,7" Margin="7,0,0,0"><StackPanel><TextBlock Text="本地文件" Foreground="#FF8492AA" FontSize="10" LineHeight="16"/><TextBlock Text="HTML · PDF" Foreground="#FFB7C9EC" FontSize="11" FontWeight="Bold" LineHeight="18" Margin="0,1,0,0"/></StackPanel></Border></Grid>
